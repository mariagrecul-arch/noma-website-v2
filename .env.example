# Kopiere diese Datei zu ".env" und trage deinen Schlüssel ein.
# Die .env-Datei NIE veröffentlichen oder hochladen (steht in .gitignore).

# Pflicht: dein OpenAI-API-Schlüssel (beginnt mit sk-)
OPENAI_API_KEY=sk-hier-deinen-schluessel-einfuegen

# Optional: Modell. Standard ist gpt-5-mini (schnell und günstig, kann Bilder lesen).
# Für noch genauere Analysen z. B. gpt-5.5 eintragen (teurer).
OPENAI_MODEL=gpt-5-mini

# Optional: maximale Analysen pro Besucher in 10 Minuten (Standard 8)
RATE_LIMIT_MAX=8

# Optional: Webhook für das Kontaktformular (z. B. Make.com "Custom webhook")
CONTACT_WEBHOOK_URL=

# Optional: Port für den lokalen Server
PORT=3000
